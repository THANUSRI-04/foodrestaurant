# Food in Forest - Environment Variables Template
# Copy this file to .env for local development or set these variables in Render / Hosting Dashboard.
# DO NOT commit your actual .env file or real secrets to GitHub.

# Server Configuration
PORT=5000
FLASK_ENV=production
SECRET_KEY=your_strong_random_secret_key_here

# Firebase Realtime Database
FIREBASE_DATABASE_URL=https://food-in-forest-default-rtdb.firebaseio.com/

# CORS Configuration (Comma-separated allowed origins or * for all)
ALLOWED_ORIGINS=https://food-in-forest.vercel.app,http://localhost:3000,http://127.0.0.1:5500
